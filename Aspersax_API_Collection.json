			"item": [
				{ "name": "1. Registro de usuarios", "request": { "method": "POST", "url": { "raw": "{{base_url}}/api/auth/registro/" }, "body": { "mode": "raw", "raw": "{\n    \"username\": \"Fredy\",\n    \"email\": \"fredy@ejemplo.com\",\n    \"password\": \"Fredy123.\",\n    \"password2\": \"Fredy123.\"\n}", "options": { "raw": { "language": "json" } } } } },
